{
  "schema_version": 1,
  "release": "0.1.0",
  "include": [
    "harness.py",
    "harness/__init__.py",
    "harness/cli.py",
    "harness/install.py",
    "harness/manifest.json",
    {"pattern": "harness/config.py", "required": false},
    {"pattern": "harness/evaluation.py", "required": false},
    {"pattern": "harness/profiles.py", "required": false},
    {"pattern": "harness/schema.py", "required": false},
    {"pattern": "profiles/*.json", "required": false},
    {"pattern": "evals/scenarios/*.json", "required": false},
    {"pattern": "evals/fixtures/**/*", "required": false},
    ".claude/CLAUDE.md",
    ".claude/agents/verifier.md",
    ".claude/hooks/workflow.py",
    ".claude/rules/verification.md",
    ".claude/rules/workflow.md",
    ".claude/settings.json",
    ".claude/skills/implement-task/SKILL.md",
    ".claude/skills/implement-task/references/recovery.md",
    ".claude/skills/plan-task/SKILL.md",
    ".claude/skills/plan-task/templates/task.md",
    ".claude/skills/review-task/SKILL.md",
    ".claude/skills/review-task/templates/review.md",
    "docs/testing-policy.md",
    "docs/testing/*.md",
    {"pattern": "docs/configuration.md", "required": false},
    {"pattern": "docs/installation.md", "required": false},
    {"pattern": "docs/evaluation.md", "required": false}
  ]
}
