digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.8", ranksep="0.9", splines=ortho, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f1f6f3", color="#a9beb5", fontname="Arial", fontsize=18, margin="0.22,0.15", penwidth=1.3];
edge [color="#71867e", fontcolor="#4f625a", fontname="Arial", fontsize=15, penwidth=1.4, arrowsize=0.8];
start [label="세션 시작·재개", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
load [label="CLAUDE.md·rules 로딩\nsettings.json 처리", group=main];
enabled [label="SessionStart Hook이\n활성화되어 있는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
skip [label="시작 Hook 안내 없음\n설정·연결 확인", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
call [label="hook-session 실행", group=main];
state [label="현재 작업이 있는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
active [label="작업 ID·단계\n읽을 문서 위치 안내", group=main];
none [label="기본 지침·작업 목록 위치 안내"];
next [label="요청 분류로\n문서 본문은 필요할 때 읽기", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
{ rank=same; enabled; skip; }
{ rank=same; state; none; }
start -> load [xlabel="", weight=30];
load -> enabled [xlabel="", weight=30,headport=n, headclip=false];
enabled -> skip [xlabel="아니오", weight=1,tailport=e, tailclip=false];
enabled -> call [xlabel="예", weight=30,tailport=s, tailclip=false];
call -> state [xlabel="", weight=30,headport=n, headclip=false];
state -> active [xlabel="있음", weight=30,tailport=s, tailclip=false];
state -> none [xlabel="없음", weight=1,tailport=e, tailclip=false];
active -> next [xlabel="", weight=30];
none -> next [xlabel="", weight=1];
}