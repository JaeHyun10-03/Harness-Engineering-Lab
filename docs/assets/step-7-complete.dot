digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.8", ranksep="0.9", splines=ortho, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f1f6f3", color="#a9beb5", fontname="Arial", fontsize=18, margin="0.22,0.15", penwidth=1.3];
edge [color="#71867e", fontcolor="#4f625a", fontname="Arial", fontsize=15, penwidth=1.4, arrowsize=0.8];
start [label="메인: 진행 기록 정리 → complete", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
ready [label="ready 상태인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
valid [label="최신 코드·테스트·리뷰\n완료 조건 충족?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
reject [label="완료 거부 → 재진행\n한도 도달 시 결정 대기", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
done [label="done 기록 → 결과·한계 보고", group=main];
stop [label="응답 종료 시 Stop Hook", group=main];
exempt [label="작업 없음 /\n계획·대기·막힘?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
check [label="done +\n최신 증거 유효?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
loop [label="Stop Hook으로\n이어진 응답인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09"];
allow [label="응답 종료 허용\n기존 작업 상태 유지", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
warn [label="미완료 안내 후 종료\ndone 변경 없음", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc"];
block [label="한 번 종료 차단\n필요한 조치 안내"];
work [label="수정·재검증 또는\nwait / block → 보고"];
response [label="작업 중 응답 종료", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc"];
{ rank=same; loop; warn; }
start -> ready [xlabel="", weight=30,headport=n, headclip=false];
ready -> reject [xlabel="아니오", weight=1,tailport=e, tailclip=false];
ready -> valid [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
valid -> reject [xlabel="아니오", weight=1,tailport=e, tailclip=false];
valid -> done [xlabel="예", weight=30,tailport=s, tailclip=false];
done -> stop [xlabel="", weight=30];
stop -> exempt [xlabel="", weight=30,headport=n, headclip=false];
exempt -> allow [xlabel="예", weight=1,tailport=e, tailclip=false];
exempt -> check [xlabel="아니오", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
check -> allow [xlabel="예", weight=30,tailport=s, tailclip=false];
check -> loop [xlabel="아니오", weight=1,tailport=e, tailclip=false, headport=n, headclip=false];
loop -> warn [xlabel="예", weight=1,tailport=s, tailclip=false];
loop -> block [xlabel="아니오", weight=1,tailport=e, tailclip=false];
block -> work [xlabel="", weight=1];
work -> stop [xlabel="다시 응답 종료 시", weight=1];
response -> stop [xlabel="완료 여부와 무관하게", weight=1];
}