digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.8", ranksep="0.9", splines=ortho, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f1f6f3", color="#a9beb5", fontname="Arial", fontsize=18, margin="0.22,0.15", penwidth=1.3];
edge [color="#71867e", fontcolor="#4f625a", fontname="Arial", fontsize=15, penwidth=1.4, arrowsize=0.8];
start [label="사용자 요청·요청별 지침 읽기", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
kind [label="단순 질문인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
q [label="관련 자료 확인 → 답변", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc"];
r [label="review-task\n읽기 전용 검증 → 보고", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc"];
h [label="결정·실험·관련 설정 확인\n개선 범위 정하기", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc"];
new [label="새 작업인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
p [label="plan-task → 새 계획", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc"];
old [label="status·task.md·progress.md\n실제 코드 대조", group=main];
clear [label="기존 작업과 요청의\n관계가 명확한가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
resume [label="implement-task → 재개", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
ask [label="사용자에게 관계·범위 확인", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
isreview [label="리뷰만 요청했는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
isharness [label="하네스 개선 요청인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
{ rank=same; new; p; }
{ rank=same; clear; ask; }
{ rank=same; kind; q; }
{ rank=same; isreview; r; }
{ rank=same; isharness; h; }
start -> kind [xlabel="", weight=30,headport=n, headclip=false];
new -> p [xlabel="예", weight=1,tailport=e, tailclip=false];
new -> old [xlabel="아니오", weight=30,tailport=s, tailclip=false];
old -> clear [xlabel="", weight=30,headport=n, headclip=false];
clear -> resume [xlabel="예", weight=30,tailport=s, tailclip=false];
clear -> ask [xlabel="아니오", weight=1,tailport=e, tailclip=false];
kind -> q [xlabel="예", weight=1,tailport=e, tailclip=false];
kind -> isreview [xlabel="아니오", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
isreview -> r [xlabel="예", weight=1,tailport=e, tailclip=false];
isreview -> isharness [xlabel="아니오", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
isharness -> h [xlabel="예", weight=1,tailport=e, tailclip=false];
isharness -> new [xlabel="아니오: 개발", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
}