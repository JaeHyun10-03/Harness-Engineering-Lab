digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.8", ranksep="0.9", splines=ortho, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f1f6f3", color="#a9beb5", fontname="Arial", fontsize=18, margin="0.22,0.15", penwidth=1.3];
edge [color="#71867e", fontcolor="#4f625a", fontname="Arial", fontsize=15, penwidth=1.4, arrowsize=0.8];
start [label="작업 문서·구현 스킬·관련 코드 읽기", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
room [label="리뷰 회차가\n남았는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
wait [label="waiting → 사용자 결정 대기", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
ready [label="목표·범위·완료 기준\n작성 완료?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
fill [label="계획 보완"];
begin [label="start → implementing", group=main];
edit [label="파일 수정 요청", group=main];
tool [label="Edit·Write 호출인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
path [label="app / scripts / tests\n아래 파일인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
phase [label="현재 구현 단계인가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
deny [label="호출 거부\n계획·상태 확인"];
allowed [label="수정 실행\n해당 Hook은 차단하지 않음", group=main];
record [label="진행 기록 갱신", group=main];
problem [label="선택·환경\n문제가 있는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
stop [label="wait / block\n미완료·재개 조건 보고", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
more [label="남은 구현이\n있는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
done [label="테스트 단계로", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
{ rank=same; room; wait; }
{ rank=same; ready; fill; }
{ rank=same; phase; deny; }
{ rank=same; problem; stop; }
start -> room [xlabel="", weight=30,headport=n, headclip=false];
room -> wait [xlabel="아니오", weight=1,tailport=e, tailclip=false];
room -> ready [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
ready -> fill [xlabel="아니오", weight=1,tailport=e, tailclip=false];
fill -> ready [xlabel="보완 후", weight=1,headport=w, headclip=false];
ready -> begin [xlabel="예", weight=30,tailport=s, tailclip=false];
begin -> edit [xlabel="", weight=30];
edit -> tool [xlabel="", weight=30,headport=n, headclip=false];
tool -> allowed [xlabel="아니오", weight=1,tailport=e, tailclip=false];
tool -> path [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
path -> allowed [xlabel="아니오", weight=1,tailport=e, tailclip=false];
path -> phase [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
phase -> allowed [xlabel="예", weight=30,tailport=s, tailclip=false];
phase -> deny [xlabel="아니오", weight=1,tailport=e, tailclip=false];
deny -> room [xlabel="재개 조건 확인", weight=1,headport=w, headclip=false];
allowed -> record [xlabel="", weight=30];
record -> problem [xlabel="", weight=30,headport=n, headclip=false];
problem -> stop [xlabel="예", weight=1,tailport=e, tailclip=false];
problem -> more [xlabel="아니오", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
more -> edit [xlabel="예", weight=1,tailport=e, tailclip=false];
more -> done [xlabel="아니오", weight=30,tailport=s, tailclip=false];
}