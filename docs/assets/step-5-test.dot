digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.8", ranksep="0.9", splines=ortho, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f1f6f3", color="#a9beb5", fontname="Arial", fontsize=18, margin="0.22,0.15", penwidth=1.3];
edge [color="#71867e", fontcolor="#4f625a", fontname="Arial", fontsize=15, penwidth=1.4, arrowsize=0.8];
start [label="task.md·checks.json 확인", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
room [label="리뷰 회차가\n남았는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
wait [label="waiting → 사용자 결정 대기", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
config [label="단계·명령·환경\n실행 준비 완료?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
setup [label="설정·환경 복구 / block\n준비 후 다시 시작", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
before [label="verify → 테스트 전 코드 식별\n일반 테스트 실행", group=main];
normal [label="일반 테스트 통과?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
need [label="성능 테스트가 필요한가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
perf [label="후속 성능 테스트 실행", group=main];
target [label="성능 목표 충족?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
record [label="실행별 결과·로그 보존", group=main];
stable [label="코드 변경 없음 +\n필수 명령 모두 성공?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
fail [label="실패 기록 → implementing\n환경 문제는 block"];
can [label="지금 수정·복구 가능한가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09"];
pause [label="미완료·재개 조건 보고", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
fix [label="구현으로 돌아가 수정"];
done [label="reviewing → 결과 리뷰", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
{ rank=same; room; wait; }
{ rank=same; config; setup; }
{ rank=same; can; pause; }
start -> room [xlabel="", weight=30,headport=n, headclip=false];
room -> wait [xlabel="아니오", weight=1,tailport=e, tailclip=false];
room -> config [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
config -> setup [xlabel="아니오", weight=1,tailport=e, tailclip=false];
config -> before [xlabel="예", weight=30,tailport=s, tailclip=false];
before -> normal [xlabel="", weight=30,headport=n, headclip=false];
normal -> fail [xlabel="아니오", weight=1,tailport=e, tailclip=false];
normal -> need [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
need -> record [xlabel="아니오: 계획에 이유 기록", weight=1,tailport=e, tailclip=false];
need -> perf [xlabel="예", weight=30,tailport=s, tailclip=false];
perf -> target [xlabel="", weight=30,headport=n, headclip=false];
target -> fail [xlabel="아니오·미실행", weight=1,tailport=e, tailclip=false];
target -> record [xlabel="예", weight=30,tailport=s, tailclip=false];
record -> stable [xlabel="", weight=30,headport=n, headclip=false];
stable -> done [xlabel="예", weight=30,tailport=s, tailclip=false];
stable -> fail [xlabel="아니오", weight=1,tailport=e, tailclip=false];
fail -> can [xlabel="", weight=1,headport=n, headclip=false];
can -> pause [xlabel="아니오", weight=1,tailport=s, tailclip=false];
can -> fix [xlabel="예", weight=1,tailport=e, tailclip=false];
fix -> room [xlabel="재테스트 전 확인", weight=1,headport=w, headclip=false];
}