{
  "schema_version": 1,
  "id": "frontend-nextjs",
  "category": "frontend",
  "description": "React, TypeScript, Next.js 프로젝트의 기본 정적 검사와 테스트, 빌드 검사",
  "options": {
    "path": {
      "type": "path",
      "default": "frontend",
      "description": "package.json이 있는 프론트엔드 디렉터리"
    },
    "package_manager": {
      "type": "enum",
      "default": "npm",
      "values": [
        "npm",
        "pnpm",
        "yarn"
      ],
      "description": "프로젝트가 사용하는 패키지 관리자"
    }
  },
  "checks": [
    {
      "id": "frontend-lint",
      "kind": "lint",
      "cwd": "${path}",
      "argv": [
        "${package_manager}",
        "run",
        "lint"
      ],
      "required": true,
      "timeout_seconds": 180,
      "description": "ESLint 규칙 검사"
    },
    {
      "id": "frontend-typecheck",
      "kind": "static",
      "cwd": "${path}",
      "argv": [
        "${package_manager}",
        "run",
        "typecheck"
      ],
      "required": true,
      "timeout_seconds": 180,
      "description": "TypeScript 타입 검사"
    },
    {
      "id": "frontend-test",
      "kind": "unit",
      "cwd": "${path}",
      "argv": [
        "${package_manager}",
        "run",
        "test",
        "--",
        "--run"
      ],
      "required": true,
      "timeout_seconds": 300,
      "description": "프론트엔드 단위 및 컴포넌트 테스트"
    },
    {
      "id": "frontend-build",
      "kind": "build",
      "cwd": "${path}",
      "argv": [
        "${package_manager}",
        "run",
        "build"
      ],
      "required": true,
      "timeout_seconds": 600,
      "description": "Next.js 프로덕션 빌드"
    }
  ],
  "rules": [
    "로딩, 오류, 빈 상태와 서버/클라이언트 컴포넌트 경계를 명세한다.",
    "NEXT_PUBLIC_ 접두사가 없는 비밀값을 클라이언트 번들에 노출하지 않는다.",
    "핵심 사용자 흐름은 프로젝트의 E2E 도구로 별도 검사한다."
  ]
}
