{
  "schema_version": 1,
  "project": {
    "name": "harness-lab",
    "type": "tooling",
    "source_paths": [
      "harness",
      "tests"
    ]
  },
  "profile_defaults": {
    "frontend": "frontend-nextjs",
    "backend": "backend-spring",
    "database": "database-postgresql",
    "devops": "devops-github-actions-ec2"
  },
  "profiles": [
    {
      "id": "frontend-nextjs",
      "enabled": false,
      "options": {
        "path": "frontend",
        "package_manager": "npm"
      }
    },
    {
      "id": "backend-spring",
      "enabled": false,
      "options": {
        "path": "backend",
        "build_executable": "./gradlew"
      }
    },
    {
      "id": "database-postgresql",
      "enabled": false,
      "options": {}
    },
    {
      "id": "devops-github-actions-ec2",
      "enabled": false,
      "options": {}
    }
  ],
  "checks": [
    {
      "id": "harness-unit",
      "kind": "unit",
      "cwd": ".",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "required": true,
      "timeout_seconds": 300,
      "description": "하네스 자체 회귀 테스트"
    }
  ]
}
