budget -> wait [xlabel="아니오", weight=1,tailport=e, tailclip=false];
build -> test [xlabel="", weight=30];
test -> tested [xlabel="", weight=30,headport=n, headclip=false];
tested -> review [xlabel="예", weight=30,tailport=s, tailclip=false];
tested -> recover [xlabel="아니오", weight=1,tailport=e, tailclip=false, headport=n, headclip=false];
recover -> budget [xlabel="가능", weight=1,tailport=s, tailclip=false, headport=w, headclip=false];
recover -> blocked [xlabel="불가·선택 필요", weight=1,tailport=e, tailclip=false];
review -> verdict [xlabel="", weight=30,headport=n, headclip=false];
verdict -> pass [xlabel="통과 권고·필수 근거 충족", weight=30,tailport=s, tailclip=false];
verdict -> fail [xlabel="실제 결함", weight=1,tailport=e, tailclip=false];
verdict -> callfail [xlabel="호출 불가·근거 부족·이견", weight=1,tailport=w, tailclip=false];
fail -> budget [xlabel="수정 전 회차 확인", weight=1,headport=w, headclip=false];
pass -> complete [xlabel="", weight=30];
complete -> valid [xlabel="", weight=30,headport=n, headclip=false];
valid -> done [xlabel="예", weight=30,tailport=s, tailclip=false];
valid -> recover [xlabel="아니오", weight=1,tailport=e, tailclip=false, headport=n, headclip=false];
wait -> extend [xlabel="", weight=1,headport=n, headclip=false];
extend -> extra [xlabel="명시적 허락", weight=1,tailport=s, tailclip=false];
extend -> hold [xlabel="없음·보류", weight=1,tailport=e, tailclip=false];
extra -> budget [xlabel="", weight=1,headport=w, headclip=false];
kind -> other [xlabel="아니오", weight=1,tailport=e, tailclip=false];
}