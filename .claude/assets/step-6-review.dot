digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.8", ranksep="0.9", splines=ortho, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#f1f6f3", color="#a9beb5", fontname="Arial", fontsize=18, margin="0.22,0.15", penwidth=1.3];
edge [color="#71867e", fontcolor="#4f625a", fontname="Arial", fontsize=15, penwidth=1.4, arrowsize=0.8];
start [label="메인: 최신 테스트 결과 준비", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
room [label="리뷰 회차가\n남았는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
fresh [label="최신 테스트·로그 유효 +\n진행 중 리뷰 없음?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
prepare [label="진행 중 리뷰 처리 /\n수정·테스트 후 재준비"];
begin [label="review-begin → 회차 +1\n검증 대상 기록", group=main];
call [label="verifier 읽기 전용 검증", group=main];
returned [label="검증 결과를 받았는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
callfail [label="block → 호출 실패 보고\n회차는 이미 소비됨", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
save [label="메인: review.md에 실제 응답 보존", group=main];
clear [label="필수 근거 충분 +\n판정 이견 해소?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
unknown [label="wait / block\n부족한 근거·이견 보고", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
defect [label="미해결 결함 또는\n필수 기준 위반?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09", group=main];
pass [label="review pass → ready\n선택적 개선은 후속 제안", shape=oval, fillcolor="#eaf1f7", color="#a9bdcc", group=main];
fail [label="review fail 등록"];
remaining [label="리뷰 회차가\n남았는가?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09"];
fix [label="메인: 수정 → verify\n이전 지적·결과 갱신"];
wait [label="waiting · 자동 수정 중단\n문제·시도·선택지 보고"];
permission [label="추가 리뷰 1회\n사용자 허락?", shape=diamond, style=filled, fillcolor="#f9f5e9", color="#c4b894", margin="0.14,0.09"];
hold [label="미완료 보류", shape=oval, fillcolor="#f3ede6", color="#c4b39b"];
extend [label="review-extend → 한도 +1\n기존 횟수·기록 유지"];
{ rank=same; fresh; prepare; }
{ rank=same; returned; callfail; }
{ rank=same; clear; unknown; }
{ rank=same; defect; fail; }
{ rank=same; permission; hold; }
start -> room [xlabel="", weight=30,headport=n, headclip=false];
room -> fresh [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
room -> wait [xlabel="아니오", weight=1,tailport=e, tailclip=false];
fresh -> prepare [xlabel="아니오", weight=1,tailport=e, tailclip=false];
prepare -> room [xlabel="준비 후", weight=1,headport=w, headclip=false];
fresh -> begin [xlabel="예", weight=30,tailport=s, tailclip=false];
begin -> call [xlabel="", weight=30];
call -> returned [xlabel="", weight=30,headport=n, headclip=false];
returned -> callfail [xlabel="아니오", weight=1,tailport=e, tailclip=false];
returned -> save [xlabel="예", weight=30,tailport=s, tailclip=false];
save -> clear [xlabel="", weight=30,headport=n, headclip=false];
clear -> unknown [xlabel="아니오", weight=1,tailport=e, tailclip=false];
clear -> defect [xlabel="예", weight=30,tailport=s, tailclip=false, headport=n, headclip=false];
defect -> pass [xlabel="아니오", weight=30,tailport=s, tailclip=false];
defect -> fail [xlabel="예", weight=1,tailport=e, tailclip=false];
fail -> remaining [xlabel="", weight=1,headport=n, headclip=false];
remaining -> fix [xlabel="예", weight=1,tailport=s, tailclip=false];
remaining -> wait [xlabel="아니오", weight=1,tailport=e, tailclip=false];
fix -> room [xlabel="테스트 통과 후", weight=1,headport=w, headclip=false];
wait -> permission [xlabel="", weight=1,headport=n, headclip=false];
permission -> hold [xlabel="없음·보류", weight=1,tailport=s, tailclip=false];
permission -> extend [xlabel="명시적 허락", weight=1,tailport=e, tailclip=false];
extend -> fix [xlabel="", weight=1];
}